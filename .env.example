MODELS_DIR=/tmp/piper-models
PORT=8000
CLASSIO_ALLOWED_ORIGINS=https://classio-eta.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Set the same random 32+ character value in Vercel's SERVER environment.
CLASSIO_TTS_SIGNING_SECRET=
# Mount persistent private storage here on the host for resumable/replay jobs.
PODCAST_DATA_DIR=/tmp/classio-podcasts
# Temporarily enable only if old clients still require the unscoped endpoint.
CLASSIO_ALLOW_LEGACY_TTS=false

# Medium preserves the existing resource profile. High upgrades Aria/Echo models;
# review the downloaded model cards and test host memory before enabling it.
CLASSIO_VOICE_QUALITY=medium
# Generated server audio is an ephemeral cache, pruned on startup/new jobs.
PODCAST_CACHE_TTL_SECONDS=86400
